{
  "format_version": 1,
  "id": "deep-house-chords",
  "name": "Deep house, dusty chords",
  "description": "Deep house: ninth chords hanging like dust in late light, offbeat open hats, bass gates that ring a little too long — on purpose.",
  "kind": "genre",
  "taste_tags": ["deep house", "house", "deep"],
  "eras": {
