      "style_card": "Ninth chords hanging like dust in late light. Offbeat open hats carry the pulse; bass notes ring long; pads breathe slowly. Keep it sparse above the low end and let every chord land like it might not come again.",
      "harmony": {
        "progressions": [
          [{"root": 29, "minor": true}, {"root": 37, "minor": false}, {"root": 34, "minor": true}, {"root": 37, "minor": false}],
          [{"root": 29, "minor": true}, {"root": 32, "minor": false}, {"root": 39, "minor": false}, {"root": 37, "minor": false}]
        ]
      },
      "groove": {
        "template": "drunk-shuffle",
        "swing": 0.14,
        "jitter_ticks": 3.0,
        "affinities": { "drunk-shuffle": 0.85, "laid-back": 0.75, "mpc-ish": 0.5 }
      },
      "rack": {
